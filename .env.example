# =================================================================
# UNIFIED QWEN & DEEPSEEK API PROXY CONFIGURATION
# =================================================================

# ----------------- Server Settings -----------------
PORT=8000
HOST=0.0.0.0

# Unified API Key (leave empty to disable Bearer token check)
# Clients (Open WebUI, Cursor, LiteLLM, NextChat, etc.) use this 1 key for ALL models!
API_KEY=sk-unified-free-key

# Default model when not specified in chat completion request
DEFAULT_MODEL=qwen3.7-max

# CORS Allowed Origins (comma-separated, e.g. http://localhost:3000,*)
ALLOWED_ORIGINS=*

# Rate limiting per IP (requests per minute; set DISABLE_RATE_LIMIT=true to disable)
RATE_LIMIT_PER_MINUTE=60
DISABLE_RATE_LIMIT=false

# ----------------- DeepSeek Settings -----------------
# Headless mode for Playwright browser automation (set to false for visible window during initial login)
HEADLESS=true

# DeepSeek Chat web interface URL
CHAT_URL=https://chat.deepseek.com

# Directory for storing browser user profile and cookies
USER_DATA_DIR=./data/pw_profile
COOKIE_FILE=./data/cookies.txt
DATA_DIR=./data
PROFILES_FILE=./profiles.json

# Session pool settings (seconds in cooldown after error, and max queue wait)
POOL_COOLDOWN_SECONDS=300
POOL_MAX_WAIT_SECONDS=120
REQUEST_QUEUE_TIMEOUT=5.0
TABS_PER_PROFILE=1

# Memory Mode:
# 'client' - client sends full history; server flattens and starts fresh chat each turn (ideal for Cursor/Open WebUI/stateless)
# 'server' - DeepSeek keeps thread context on server; only last message sent
MEMORY_MODE=client

# Optional antidetect (e.g. patchright)
ANTIDETECT=patchright

# Optional context summarizer using external LLM
SUMMARIZER_API_URL=
SUMMARIZER_MODEL=
SUMMARIZER_API_KEY=

# ----------------- Qwen Settings -----------------
# Qwen Chat URL & session storage
QWEN_BASE_URL=https://chat.qwen.ai
SESSION_DIR=./session
QWEN_RATE_LIMIT_HOURS=24

# Optional DashScope API key for extra Alibaba image generation models
DASHSCOPE_API_KEY=
